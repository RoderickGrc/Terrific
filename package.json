{
  "name": "terrific-cli",
  "version": "0.0.0",
  "description": "Record QA sessions in a real browser from your terminal, with context ready for coding agents",
  "keywords": [
    "qa",
    "testing",
    "browser",
    "playwright",
    "cli",
    "tui",
    "agents"
  ],
  "license": "MIT",
  "author": "Rodrigo Garciaguirre",
  "type": "module",
  "bin": {
    "terrific": "dist/bin.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoderickGrc/terrific-cli.git"
  },
  "homepage": "https://github.com/RoderickGrc/terrific-cli#readme",
  "bugs": {
    "url": "https://github.com/RoderickGrc/terrific-cli/issues"
  },
  "scripts": {
    "dev": "node src/bin.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "check:legacy": "node scripts/check-legacy.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/smoke-dist.ts && publint && node scripts/check-pack.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@types/turndown": "5.0.6",
    "@xterm/headless": "5.5.0",
    "publint": "0.3.25",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.5.0",
    "@toon-format/toon": "4.4.0",
    "commander": "15.0.0",
    "playwright-core": "1.64.1",
    "turndown": "7.2.4"
  }
}
